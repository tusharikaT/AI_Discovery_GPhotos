# Copy this file to `.env` and fill in as needed. `.env` is git-ignored.
# All values are OPTIONAL for Phase 0 (sensible defaults live in config/settings.py).

# --- LLM (decided at Phase 3) ---
LLM_PROVIDER=openai              # openai | anthropic | local
LLM_MODEL=                       # e.g. gpt-4o-mini or claude-3-5-haiku
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CONCURRENCY=4
LLM_TEMPERATURE=0.0

# --- Embeddings (decided after Phase 4) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=64

# --- Scraping (Phase 1) ---
# 0 = unbounded (web-first, no hard cap)
SCRAPE_MAX_ITEMS_PER_SOURCE=0
SCRAPE_SMOKE_LIMIT=30
REQUEST_TIMEOUT_S=20

# --- Filtering ---
RELEVANCE_SCORE_THRESHOLD=0.55
DEDUP_SIMILARITY_THRESHOLD=0.90
KEEP_COMPETITOR_ITEMS=false
